project "noxide" {
    version = file("./VERSION")
    description = "A focused Rust code editor with native Nox project integration."
    license = "Unlicense"
    edition = "1"
    version_files = ["VERSION", "Cargo.toml"]

    rust_executable "noxide" {
        sources = ["src/main.rs"]
        flags = []
        install = true
    }
}
